[sub_resource type="GDScript" id="GDScript_3vyb7"]
script/source = "extends CharacterBody2D


const SPEED = 50.0

func _physics_process(delta: float) -> void:
	var horizontalDir = Input.get_axis(\"left\", \"right\")
	var verticalDir = Input.get_axis(\"up\", \"down\")
	
	# control the vertical movement i.e. in y axis
	if verticalDir:
		velocity.y = verticalDir * SPEED
	else:
		velocity.y = move_toward(velocity.y, 0, SPEED)
		
	# control the horizontal movement i.e. in x axis
	if horizontalDir:
		velocity.x = horizontalDir * SPEED
	else:
		# reset the horizontal spped to 0
		velocity.x = move_toward(velocity.x, 0, SPEED)
		
	global_position = global_position.round()

	move_and_slide()
"

